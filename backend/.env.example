# ==============================================================================================
# NOTAS BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in real values. Never commit .env to version control!
# ==============================================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (e.g. Neon, Supabase, AWS RDS, or local PostgreSQL)
# For serverless deployment (Vercel), use connection pooler URL (e.g. with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:password@localhost:5432/notas?schema=public&connection_limit=10"
DIRECT_URL="postgresql://postgres:password@localhost:5432/notas?schema=public"

# Firebase Admin SDK Credentials
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="smartnotas-production"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@smartnotas-production.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# S3-Compatible Private Object Storage (AWS S3, Cloudflare R2, or Supabase Storage)
# Used exclusively for private binary backups
S3_ENDPOINT="" # Leave empty for AWS S3, set to https://<account_id>.r2.cloudflarestorage.com for Cloudflare R2
S3_REGION="eu-central-1"
S3_BUCKET_NAME="notas-user-backups"
S3_ACCESS_KEY_ID="AKIA_PLACEHOLDER_KEY"
S3_SECRET_ACCESS_KEY="PLACEHOLDER_SECRET_ACCESS_KEY"
S3_FORCE_PATH_STYLE="false" # Set to "true" for MinIO or local testing

# Rate Limiting & Distributed Protection
# Optional: Set Upstash Redis REST credentials for distributed rate limiting across Vercel lambdas
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# CORS & Payload Protection
ALLOWED_ORIGINS="*" # Comma-separated list of allowed origins or "*" in development
MAX_PAYLOAD_SIZE_BYTES=4194304 # 4 MB
RATE_LIMIT_SYNC_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_BACKUP_PER_MINUTE=10

