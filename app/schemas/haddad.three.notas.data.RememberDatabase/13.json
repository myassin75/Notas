          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_notes_fts_AFTER_INSERT AFTER INSERT ON `notes` BEGIN INSERT INTO `notes_fts`(`docid`, `title`, `body`, `checklistText`, `attachmentText`, `actionsText`) VALUES (NEW.`rowid`, NEW.`title`, NEW.`body`, NEW.`checklistText`, NEW.`attachmentText`, NEW.`actionsText`); END"
